<resources>
    <style name="Theme.Habitly" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Habitly.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F1F3F0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Habitly</item>
    </style>
</resources>
